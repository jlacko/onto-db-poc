    skos:notation 592935 ;
    skos:prefLabel "Březina"@cs ;
    skos:topConceptOf krimc:municipality ;
    krim:businessDefinition "Vojenský újezd Březina (u Vyškova); podle zákona o obcích není obcí, zde se s ním zachází jako s obcí."@cs .

