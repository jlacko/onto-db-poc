@prefix krim:    <https://example.org/kriminalita/ontology#> .
@prefix kdb:     <https://example.org/kriminalita/db#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .

# SHACL shapes: what records must contain (closed world). The OWL module says
# what things mean; these shapes say what valid data looks like, and
# scripts/generate_ddl.py turns them into the SQLite schema.
#
# kdb: annotations are database-mapping hints only; they carry no meaning.

<https://example.org/kriminalita/shapes>
    a owl:Ontology ;
    owl:imports <https://example.org/kriminalita/ontology> ;
    owl:versionInfo "0.1.0" .

# ---------------------------------------------------------------------
# Mapping vocabulary
# ---------------------------------------------------------------------
kdb:table        a owl:AnnotationProperty ; rdfs:comment "SQL table realising the node shape's target class." .
kdb:iriColumn    a owl:AnnotationProperty ; rdfs:comment "Column holding the focus node IRI." .
kdb:column       a owl:AnnotationProperty ; rdfs:comment "SQL column realising the property shape." .
kdb:primaryKey   a owl:AnnotationProperty ; rdfs:comment "true if the column is the table's primary key." .
kdb:linkTable    a owl:AnnotationProperty ; rdfs:comment "Many-valued property stored in a separate link table of this name." .
kdb:languageColumns a owl:AnnotationProperty ; rdfs:comment "One column per language tag, named <column>_<lang>." .
kdb:sourceField  a owl:AnnotationProperty ; rdfs:comment "Field name in the publisher's CSV extract." .
kdb:index        a owl:AnnotationProperty ; rdfs:comment "true if the column needs a secondary index (foreign-key columns get one without the hint)." .
kdb:uniqueColumns a owl:AnnotationProperty ; rdfs:comment "List of column names that are unique together: a UNIQUE index, the database counterpart of a uniqueness rule." .

# ---------------------------------------------------------------------
# Offence record (operational data)
# ---------------------------------------------------------------------
krim:OffenceRecordShape
    a sh:NodeShape ;
    sh:targetClass krim:OffenceRecord ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    kdb:table "offence_record" ;
    kdb:iriColumn "iri" ;

    sh:property [
        sh:path dcterms:identifier ;
        sh:name "record id"@en , "identifikátor záznamu"@cs ;
        skos:definition "The publisher's integer identifier of an offence record, stable across the publisher's download files and refreshes."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "Every offence record has exactly one integer identifier assigned by the publisher."@en , "Každý záznam o deliktu má právě jeden celočíselný identifikátor přidělený vydavatelem."@cs ;
        sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "id" ; kdb:primaryKey true ; kdb:sourceField "id" ; sh:order 1
    ] ;
    sh:property [
        sh:path krim:reportDateTime ;
        sh:name "report date and time"@en , "datum a čas oznámení"@cs ;
        sh:description "Every offence record has exactly one report date and time."@en , "Každý záznam o deliktu má právě jedno datum a čas oznámení."@cs ;
        sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "report_datetime" ; kdb:sourceField "date" ; kdb:index true ; sh:order 2  # period questions
    ] ;
    sh:property [
        sh:path krim:inAnonymisationArea ;
        sh:name "anonymisation area"@en , "anonymizační oblast"@cs ;
        sh:description "Every offence record lies in exactly one anonymisation area, the one whose centre is its published point."@en , "Každý záznam o deliktu leží právě v jedné anonymizační oblasti, té, jejíž střed je jeho zveřejněným bodem."@cs ;
        sh:class krim:AnonymisationArea ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "area_id" ; kdb:sourceField "y, x" ; sh:order 3  # derived: the published point (y = latitude, x = longitude) is matched to an area's centre
    ] ;
    sh:property [
        sh:path krim:recordedByMunicipalPolice ;
        sh:name "recorded by municipal police"@en , "evidováno městskou policií"@cs ;
        sh:description "Every offence record states whether it was recorded by the municipal police."@en , "U každého záznamu o deliktu je uvedeno, zda jej evidovala městská policie."@cs ;
        sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "municipal_police" ; kdb:sourceField "mp" ; sh:order 5
    ] ;
    sh:property [
        sh:path krim:hasClearanceState ;
        sh:name "clearance state"@en , "stav objasnění"@cs ;
        sh:description "Every offence record has exactly one clearance state."@en , "Každý záznam o deliktu má právě jeden stav objasnění."@cs ;
        sh:class krim:ClearanceState ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "clearance_state_code" ; kdb:sourceField "state" ; sh:order 6
    ] ;
    sh:property [
        sh:path krim:hasLocationRelevance ;
        sh:name "location relevance"@en , "relevance lokality"@cs ;
        sh:description "Every offence record has exactly one location relevance."@en , "Každý záznam o deliktu má právě jednu relevanci lokality."@cs ;
        sh:class krim:LocationRelevance ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "location_relevance_code" ; kdb:sourceField "relevance" ; sh:order 7
    ] ;
    sh:property [
        sh:path krim:stateAsOf ;
        sh:name "state as of"@en , "stav ke dni"@cs ;
        sh:description "Every offence record states exactly one moment as of which its current state was reported."@en , "U každého záznamu o deliktu je uveden právě jeden okamžik, ke kterému platí jeho stav."@cs ;
        sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "state_as_of" ; sh:order 8
    ] ;
    sh:property [
        sh:path krim:hasOffenceType ;
        sh:name "offence type"@en , "třída deliktu"@cs ;
        sh:description "Every offence record has at least one offence type."@en , "Každý záznam o deliktu má alespoň jednu třídu deliktu."@cs ;
        sh:class krim:OffenceType ; sh:minCount 1 ;
        kdb:linkTable "offence_record_type" ; kdb:column "offence_type_code" ; kdb:sourceField "types" ; sh:order 9
    ] .

# Identity: one occurrence = one record. SHACL Core cannot compare values across
# focus nodes, so uniqueness is a SPARQL constraint (and the primary key in SQL).
krim:OffenceRecordIdentityShape
    a sh:NodeShape ;
    sh:targetClass krim:OffenceRecord ;
    sh:sparql [
        sh:message "An offence record identifier must identify exactly one offence record (no duplicates)."@en ,
            "Identifikátor záznamu musí označovat právě jeden záznam o deliktu (žádné duplicity)."@cs ;
        sh:prefixes <https://example.org/kriminalita/shapes> ;
        sh:select """
            SELECT $this ?value ?path WHERE {
                $this dcterms:identifier ?value .
                ?other dcterms:identifier ?value ; a krim:OffenceRecord .
                FILTER (?other != $this)
                BIND (dcterms:identifier AS ?path)
            }"""
    ] .

# Domain rule kept separate so it can be a warning: area centres should lie in
# the Czech Republic's bounding box. Not enforced by the database; reported by
# validation.
krim:AnonymisationAreaInCzechiaShape
    a sh:NodeShape ;
    sh:targetClass krim:AnonymisationArea ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path krim:centreLatitude ;
        sh:description "An anonymisation area's centre should lie between 48.5 and 51.1 degrees north."@en , "Střed anonymizační oblasti by měl ležet mezi 48,5° a 51,1° severní šířky."@cs ;
        sh:severity sh:Warning ;  # severity is per shape: it is not inherited from the node shape
        sh:minInclusive 48.5 ; sh:maxInclusive 51.1
    ] ;
    sh:property [
        sh:path krim:centreLongitude ;
        sh:description "An anonymisation area's centre should lie between 12.0 and 18.9 degrees east."@en , "Střed anonymizační oblasti by měl ležet mezi 12,0° a 18,9° východní délky."@cs ;
        sh:severity sh:Warning ;
        sh:minInclusive 12.0 ; sh:maxInclusive 18.9
    ] .

# Most-specific-type consistency: the publisher tags a record with a type and
# all its broader types. A warning, because it is a convention of the source,
# not a rule of the domain.
krim:OffenceTypeClosureShape
    a sh:NodeShape ;
    sh:targetClass krim:OffenceRecord ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "An offence record tagged with an offence type should also be tagged with its broader type."@en ,
            "Záznam označený třídou deliktu by měl nést i její nadřazenou třídu."@cs ;
        sh:prefixes <https://example.org/kriminalita/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this krim:hasOffenceType ?t .
                ?t skos:broader ?value .
                FILTER NOT EXISTS { $this krim:hasOffenceType ?value }
            }"""
    ] .

<https://example.org/kriminalita/shapes>
    sh:declare
        [ sh:prefix "krim" ; sh:namespace "https://example.org/kriminalita/ontology#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
        [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] .

# ---------------------------------------------------------------------
# Anonymisation area (reference data, kept in the database, not in Turtle)
# ---------------------------------------------------------------------
krim:AnonymisationAreaShape
    a sh:NodeShape ;
    sh:targetClass krim:AnonymisationArea ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    kdb:table "anonymisation_area" ;
    kdb:iriColumn "iri" ;
    kdb:uniqueColumns ( "centre_latitude" "centre_longitude" ) ;  # no two areas share a centre (see AnonymisationAreaCentreShape)
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "area id"@en , "identifikátor oblasti"@cs ;
        skos:definition "The publisher's integer identifier of an anonymisation area in its list of areas."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "Every anonymisation area has exactly one integer identifier assigned by the publisher."@en , "Každá anonymizační oblast má právě jeden celočíselný identifikátor přidělený vydavatelem."@cs ;
        sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "id" ; kdb:primaryKey true ; kdb:sourceField "id" ; sh:order 1
    ] ;
    sh:property [
        sh:path krim:centreLatitude ;
        sh:name "centre latitude"@en , "zeměpisná šířka středu"@cs ;
        sh:description "Every anonymisation area has exactly one centre latitude between -90 and 90 degrees."@en , "Každá anonymizační oblast má právě jednu zeměpisnou šířku středu v rozsahu -90 až 90 stupňů."@cs ;
        sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive -90 ; sh:maxInclusive 90 ;
        kdb:column "centre_latitude" ; kdb:sourceField "def_bod_y" ; sh:order 2
    ] ;
    sh:property [
        sh:path krim:centreLongitude ;
        sh:name "centre longitude"@en , "zeměpisná délka středu"@cs ;
        sh:description "Every anonymisation area has exactly one centre longitude between -180 and 180 degrees."@en , "Každá anonymizační oblast má právě jednu zeměpisnou délku středu v rozsahu -180 až 180 stupňů."@cs ;
        sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive -180 ; sh:maxInclusive 180 ;
        kdb:column "centre_longitude" ; kdb:sourceField "def_bod_x" ; sh:order 3
    ] ;
    sh:property [
        sh:path krim:inMunicipality ;
        sh:name "municipality"@en , "obec"@cs ;
        sh:description "Every anonymisation area lies in exactly one municipality."@en , "Každá anonymizační oblast leží právě v jedné obci."@cs ;
        sh:class krim:Municipality ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "municipality_code" ; kdb:sourceField "kod_obec" ; sh:order 4
    ] .

# No two areas share a centre: the centre identifies the area a published
# point belongs to. SHACL Core cannot compare focus nodes, so SPARQL; the
# database counterpart is the UNIQUE index from kdb:uniqueColumns on the area shape.
krim:AnonymisationAreaCentreShape
    a sh:NodeShape ;
    sh:targetClass krim:AnonymisationArea ;
    sh:sparql [
        sh:message "Two anonymisation areas must not share a centre."@en ,
            "Dvě anonymizační oblasti nesmějí mít stejný střed."@cs ;
        sh:prefixes <https://example.org/kriminalita/shapes> ;
        sh:select """
            SELECT $this ?value ?path WHERE {
                $this krim:centreLatitude ?lat ; krim:centreLongitude ?lon .
                ?other krim:centreLatitude ?lat ; krim:centreLongitude ?lon ; a krim:AnonymisationArea .
                FILTER (?other != $this)
                BIND (?other AS ?value)
                BIND (krim:centreLatitude AS ?path)
            }"""
    ] .

# ---------------------------------------------------------------------
# Codelist concepts (reference data)
# ---------------------------------------------------------------------
krim:CodeConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:notation ;
        sh:name "code"@en , "kód"@cs ;
        skos:definition "The publisher's integer code of a codelist item, as used in the source CSV."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "Every codelist concept has exactly one integer code, the publisher's notation."@en ;
        sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "code" ; kdb:primaryKey true ; sh:order 1
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:name "label"@en , "název"@cs ;
        skos:definition "The preferred human-readable name of a codelist item in one language."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "Every codelist concept has exactly one Czech label and at most one label per other language."@en ;
        sh:datatype rdf:langString ; sh:uniqueLang true ;
        sh:qualifiedValueShape [ sh:languageIn ( "cs" ) ] ; sh:qualifiedMinCount 1 ;
        kdb:column "label" ; kdb:languageColumns ( "cs" "en" ) ; sh:order 2
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:name "definition"@en , "definice"@cs ;
        skos:definition "A genus-differentia definition of a codelist item in English."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "A codelist concept has at most one English definition."@en ;
        sh:datatype rdf:langString ; sh:languageIn ( "en" ) ; sh:maxCount 1 ;
        kdb:column "definition_en" ; sh:order 3
    ] ;
    sh:property [
        sh:path skos:exactMatch ;
        sh:name "publisher IRI"@en , "IRI vydavatele"@cs ;
        skos:definition "The IRI of the same codelist item in the publisher's own JSON-LD codelist."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "Every codelist concept matches exactly one item IRI of the publisher's codelist."@en ;
        sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "source_iri" ; sh:order 4
    ] .

krim:OffenceTypeShape
    a sh:NodeShape ;
    sh:targetClass krim:OffenceType ;
    sh:node krim:CodeConceptShape ;
    kdb:table "offence_type" ;
    kdb:iriColumn "iri" ;
    sh:property [
        sh:path skos:broader ;
        sh:name "broader type"@en , "nadřazená třída"@cs ;
        skos:definition "The code of the offence type directly above this one in the classification hierarchy."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "An offence type has at most one broader offence type."@en ;
        sh:class krim:OffenceType ; sh:maxCount 1 ;
        kdb:column "broader_code" ; sh:order 5
    ] .

krim:ClearanceStateShape
    a sh:NodeShape ;
    sh:targetClass krim:ClearanceState ;
    sh:node krim:CodeConceptShape ;
    kdb:table "clearance_state" ;
    kdb:iriColumn "iri" ;
    sh:property [
        sh:path skos:definition ;
        sh:description "Every clearance state has an English definition."@en ;
        sh:minCount 1
    ] .

krim:LocationRelevanceShape
    a sh:NodeShape ;
    sh:targetClass krim:LocationRelevance ;
    sh:node krim:CodeConceptShape ;
    kdb:table "location_relevance" ;
    kdb:iriColumn "iri" ;
    sh:property [
        sh:path skos:definition ;
        sh:description "Every location relevance has an English definition."@en ;
        sh:minCount 1
    ] .

# Municipalities (ČSÚ codelist 43) do not use krim:CodeConceptShape: there is
# no linked-data IRI to match (RÚIAN's IRIs serve no RDF), so they have their
# own rules: a code and a Czech name; the military training areas also carry a
# definition.
krim:MunicipalityShape
    a sh:NodeShape ;
    sh:targetClass krim:Municipality ;
    kdb:table "municipality" ;
    kdb:iriColumn "iri" ;
    sh:property [
        sh:path skos:notation ;
        sh:name "municipality code"@en , "kód obce"@cs ;
        skos:definition "The six-digit code of a municipality in ČSÚ codelist 43 (the same code is used in RÚIAN)."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "Every municipality has exactly one integer code from ČSÚ codelist 43."@en , "Každá obec má právě jeden celočíselný kód z číselníku ČSÚ 43."@cs ;
        sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
        kdb:column "code" ; kdb:primaryKey true ; sh:order 1
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:name "municipality name"@en , "název obce"@cs ;
        skos:definition "The official Czech name of a municipality as listed in ČSÚ codelist 43."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "Every municipality has exactly one Czech name; names are not unique."@en , "Každá obec má právě jeden český název; názvy se mohou opakovat."@cs ;
        sh:datatype rdf:langString ; sh:languageIn ( "cs" ) ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:qualifiedValueShape [ sh:languageIn ( "cs" ) ] ; sh:qualifiedMinCount 1 ;  # makes the column NOT NULL
        kdb:column "name" ; kdb:languageColumns ( "cs" ) ; sh:order 2
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:name "definition"@en , "definice"@cs ;
        skos:definition "An English note on a municipality; present only where it needs one (the military training areas)."@en ;  # local data-element definition: the path is a generic reused property
        sh:description "A municipality has at most one English definition."@en , "Obec má nejvýše jednu anglickou definici."@cs ;
        sh:datatype rdf:langString ; sh:languageIn ( "en" ) ; sh:maxCount 1 ;
        kdb:column "definition_en" ; sh:order 3
    ] .
