@prefix krim:    <https://example.org/kriminalita/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix vs:      <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix gsp:     <http://www.opengis.net/ont/geosparql#> .

# =====================================================================
# Ontology header
# =====================================================================

<https://example.org/kriminalita/ontology>
    a owl:Ontology ;
    dcterms:title "Kriminalita ontology"@en , "Ontologie kriminality"@cs ;
    dcterms:description """Concepts for offence records published by the Police of the
Czech Republic at kriminalita.policie.gov.cz: the records themselves, their offence
types, clearance states and location relevance, the anonymisation areas their
published places stand for, and the municipalities those areas lie in, as one
continuous history keyed by
the record identifier (the publisher's monthly download files are pagination, not part
of the model). Location data exist from about mid-2013. Built ontology-first as a proof of concept; the SQLite schema is
generated from the SHACL shapes that accompany this module."""@en ;
    owl:versionIRI <https://example.org/kriminalita/ontology/0.2.0> ;
    owl:versionInfo "0.2.0" ;
    owl:priorVersion <https://example.org/kriminalita/ontology/0.1.0> ;
    dcterms:modified "2026-11-22T00:00:00"^^xsd:dateTime ;
    dcterms:source <https://kriminalita.policie.gov.cz/> ;
    rdfs:comment """Release 0.2.0: anonymisation areas and municipalities. A published location
is the centre of one of the publisher's predefined anonymisation areas, so a record
now lies in an area (krim:inAnonymisationArea), and an area in a municipality
(krim:inMunicipality, ČSÚ codelist 43). krim:anonymisedLatitude and
krim:anonymisedLongitude are deprecated, replaced by the area and its centre
(krim:centreLatitude, krim:centreLongitude). A change of meaning: before 1.0 that
is a minor version.

Release 0.1.0: initial draft. Placeholder namespace example.org. Before
release, the monthly extract (krim:MonthlyExtract, krim:referenceMonth, krim:publishedIn)
was removed: the monthly files are the publisher's pagination, not a domain concept.
krim:stateAsOf replaces it as the time axis of observation."""@en .

# =====================================================================
# Annotation properties reused (declared for OWL DL tooling)
# =====================================================================

skos:definition  a owl:AnnotationProperty .
skos:scopeNote   a owl:AnnotationProperty .
skos:example     a owl:AnnotationProperty .
skos:editorialNote a owl:AnnotationProperty .
skos:prefLabel   a owl:AnnotationProperty .
skos:altLabel    a owl:AnnotationProperty .
skos:notation    a owl:AnnotationProperty .
vs:term_status   a owl:AnnotationProperty .
dcterms:title    a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:source   a owl:AnnotationProperty .
dcterms:isReplacedBy a owl:AnnotationProperty .
skos:closeMatch  a owl:AnnotationProperty .  # used on a class (krim:Municipality) only

krim:businessDefinition
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf skos:definition ;
    rdfs:label "business definition"@en , "věcná definice"@cs ;
    skos:definition """A business definition is an annotation that gives a plain-language
definition of a term for business readers in their own language (Czech here). It
complements the formal English skos:definition, which is written for modellers."""@en ;
    skos:scopeNote "Not a translation of the formal definition but a second definition for a second audience; both must describe the same concept."@en ;
    vs:term_status "draft" .

# =====================================================================
# Classes
# =====================================================================

krim:OffenceRecord
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "offence record"@en , "záznam o deliktu"@cs ;
    skos:altLabel "delikt"@cs , "incident"@en ;
    skos:definition """An offence record is an information record, kept by the Police
of the Czech Republic, about one act reported to or detected by the police that is
suspected to be a crime or a misdemeanour."""@en ;
    skos:example "Record 25719550: an intentional bodily harm on 19 February 2025 at 20:34, unsolved."@en ;
    skos:scopeNote """The record, not the act: a record exists even when the police
later conclude that the act did not occur or is not an offence (see
krim:ClearanceState). Records reflect the last state while the police handled the
case; later decisions of prosecutors or courts are not reflected. Only offence
types whose publication has a preventive purpose are published."""@en ;
    krim:businessDefinition "Záznam Policie ČR o jednom skutku, který byl policii oznámen nebo který policie sama zjistila a který je podezřelý z trestného činu nebo přestupku."@cs ;
    skos:example "Záznam 25719550: úmyslné ublížení na zdraví oznámené 19. 2. 2025 ve 20:34, neobjasněno."@cs ;
    skos:scopeNote "Skutek samotný. Záznam existuje i tehdy, když policie později zjistí, že se skutek nestal nebo není trestným činem. Pozdější rozhodnutí státního zástupce nebo soudu se v záznamu neprojeví."@cs ;
    vs:term_status "draft" .

krim:OffenceType
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "offence type"@en , "třída deliktu"@cs ;
    skos:altLabel "typ deliktu"@cs , "druh deliktu"@cs , "offence class"@en ;
    skos:definition """An offence type is a concept in the Police CR classification of
offences ("Číselník tříd") that classifies offence records by the kind of act."""@en ;
    skos:example "Burglary – flat (code 19), a subtype of Burglary (code 18)."@en ;
    skos:scopeNote """Not a legal qualification under the Criminal Code; it is the
publisher's own statistical classification and also contains misdemeanours, fires
and traffic accidents. The classification is a hierarchy (skos:broader), and a
record is tagged with a type together with all its broader types."""@en ;
    krim:businessDefinition "Třída kriminalisticko-statistické evidence Policie ČR, podle které se záznamy třídí podle druhu skutku. Třídy tvoří hierarchii: kategorie (např. Krádeže vloupáním) a jejich podtřídy (např. Byt)."@cs ;
    skos:example "Krádeže vloupáním – byt (kód 19), podtřída kategorie Krádeže vloupáním (kód 18)."@cs ;
    skos:scopeNote "Právní kvalifikace podle trestního zákoníku. Jde o statistickou klasifikaci policie, která zahrnuje i přestupky, požáry a dopravní nehody. Záznam nese svou třídu spolu se všemi nadřazenými třídami."@cs ;
    vs:term_status "draft" .

krim:ClearanceState
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "clearance state"@en , "stav objasnění"@cs ;
    skos:definition """A clearance state is a concept that classifies an offence record
by the outcome of the police inquiry into the recorded act."""@en ;
    skos:example "Probable offender identified (code 1)."@en ;
    skos:scopeNote "Not the outcome of prosecution or a court decision."@en ;
    krim:businessDefinition "Výsledek policejního šetření skutku, například zda byl zjištěn pravděpodobný pachatel."@cs ;
    skos:example "Zjištěn pravděpodobný pachatel (kód 1)."@cs ;
    skos:scopeNote "Výsledek trestního stíhání nebo rozhodnutí soudu. Stav se v čase mění a platí vždy jen ke dni uvedenému jako stav ke dni."@cs ;
    vs:term_status "draft" .

krim:LocationRelevance
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "location relevance"@en , "relevance lokality"@cs ;
    skos:definition """A location relevance is a concept that classifies the recorded
location of an offence record by what that location stands for in relation to the
act."""@en ;
    skos:example "Place of commission (code 4)."@en ;
    skos:scopeNote "Says what the place means, not how precise it is; all published locations are anonymised."@en ;
    krim:businessDefinition "Údaj o tom, co zveřejněné místo u záznamu znamená: místo spáchání, místo oznámení, místo následku a podobně."@cs ;
    skos:example "Místo spáchání (kód 4)."@cs ;
    skos:scopeNote "Přesnost polohy. Všechny zveřejněné polohy jsou anonymizované bez ohledu na relevanci."@cs ;
    vs:term_status "draft" .

krim:AnonymisationArea
    a owl:Class ;
    rdfs:subClassOf gsp:Feature ;
    rdfs:label "anonymisation area"@en , "anonymizační oblast"@cs ;
    skos:altLabel "Voronoi polygon"@en , "Voroného polygon"@cs ;
    skos:definition """An anonymisation area is a geographic feature, one of a fixed set
of polygons defined by the publisher, to whose centre the location of every offence
record falling inside it is moved before publication."""@en ;
    skos:example "Area 29789 in Prague, with its centre at 50.0833 N, 14.6278 E."@en ;
    skos:scopeNote """Not an administrative unit, and not the true place of an act. The
publisher computed the areas once: municipalities were split into Voronoi polygons
around K-means cluster centres of the 2018 data, and municipalities with fewer than 25
offences in 2018 were left whole. The list is published as a fixed file (2022). An
area exists whether or not any record falls in it."""@en ;
    dcterms:source <https://kriminalita.policie.gov.cz/voronoi.geojson.zip> ;
    krim:businessDefinition "Oblast, do jejíhož středu vydavatel posune místo každého skutku, který v ní leží, aby nebylo možné určit skutečné místo. Obce jsou na takové oblasti rozděleny podle počtu skutků; malé obce tvoří jedinou oblast."@cs ;
    skos:example "Oblast 29789 v Praze se středem 50,0833° s. š., 14,6278° v. d."@cs ;
    skos:scopeNote "Správní jednotka nebo skutečné místo skutku. Oblasti vydavatel vypočítal jednou z dat za rok 2018 a zveřejnil je jako pevný seznam; oblast existuje, i když v ní žádný skutek neleží."@cs ;
    vs:term_status "draft" .

krim:Municipality
    a owl:Class ;
    rdfs:subClassOf skos:Concept , gsp:Feature ;
    rdfs:label "municipality"@en , "obec"@cs ;
    skos:closeMatch <https://slovník.gov.cz/legislativní/sbírka/128/2000/pojem/obec> ;
    skos:definition """A municipality is a territorial unit of the Czech Republic listed in
the Czech Statistical Office's codelist of municipalities and military training areas
(ČSÚ codelist 43) and identified by its six-digit code."""@en ;
    skos:example "Pustá Polom (code 509736), divided into four anonymisation areas."@en ;
    skos:scopeNote """Not a city district or a part of a municipality. Includes the four
military training areas (Boletice, Březina, Hradiště, Libavá): they are not
municipalities in law (Act 128/2000) and hold no elections, but they are treated as
municipalities here. RÚIAN uses the same codes."""@en ;
    dcterms:source <https://apl2.czso.cz/iSMS/cisdet.jsp?kodcis=43> ;
    krim:businessDefinition "Obec podle číselníku obcí a vojenských újezdů Českého statistického úřadu (číselník 43), určená šestimístným kódem."@cs ;
    skos:example "Pustá Polom (kód 509736), rozdělená na čtyři anonymizační oblasti."@cs ;
    skos:scopeNote "Městská část nebo část obce. Patří sem i čtyři vojenské újezdy (Boletice, Březina, Hradiště, Libavá); podle zákona o obcích obcemi nejsou, zde se s nimi ale zachází jako s obcemi."@cs ;
    vs:term_status "draft" .

krim:OrpArea
    a owl:Class ;
    rdfs:subClassOf skos:Concept , gsp:Feature ;
    rdfs:label "ORP area"@en , "správní obvod ORP"@cs ;
    skos:altLabel "administrative district of a municipality with extended powers"@en ,
        "ORP"@cs , "SO ORP"@cs , "správní obvod obce s rozšířenou působností"@cs ;
    skos:exactMatch <https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/správní-obvod-obce-s-rozšířenou-působností> ;
    skos:definition """An ORP area is a territorial unit of the Czech Republic that is the
administrative district of a municipality with extended powers, listed in the Czech
Statistical Office's codelist 65 and identified by its four-digit code."""@en ;
    skos:example "Opava (code 8117), whose municipalities include Pustá Polom."@en ;
    skos:scopeNote """Not the municipality with extended powers itself (the town of Opava
is a municipality; the ORP area is the district its office serves), and not the
smaller POU district, which is not modelled. Includes Prague (code 1000), which ČSÚ
and RÚIAN list as an ORP area although Prague is not one in law. An ORP area normally
lies within one okres; Turnov (5109) spans three."""@en ;
    dcterms:source <https://apl2.czso.cz/iSMS/cisdet.jsp?kodcis=65> ;
    krim:businessDefinition "Správní obvod obce s rozšířenou působností podle číselníku 65 Českého statistického úřadu: území obcí, pro které vykonává přenesenou působnost úřad jedné obce s rozšířenou působností."@cs ;
    skos:example "Opava (kód 8117), kam patří mimo jiné Pustá Polom."@cs ;
    skos:scopeNote "Samotná obec s rozšířenou působností (město Opava je obec, správní obvod je území, pro které její úřad pracuje) ani správní obvod obce s pověřeným obecním úřadem. Patří sem i Praha (kód 1000). Správní obvod obvykle leží v jednom okrese; Turnov (5109) zasahuje do tří."@cs ;
    vs:term_status "draft" .

krim:Okres
    a owl:Class ;
    rdfs:subClassOf skos:Concept , gsp:Feature ;
    rdfs:label "okres"@en , "okres"@cs ;
    skos:altLabel "district (LAU 1)"@en ;
    skos:closeMatch <https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/území-okresu> ;
    skos:definition """An okres is a territorial unit of the Czech Republic between the
municipality and the kraj, defined by Act 51/2020, listed in the Czech Statistical
Office's codelist 101 and identified by its five-digit code."""@en ;
    skos:example "Opava (code 40908, LAU 1 code CZ0805)."@en ;
    skos:scopeNote """Not a self-governing unit, and no longer an EU statistical unit (LAU 1
was dropped in 2017; ČSÚ keeps the codes). Not the okres of the repealed Act 36/1960,
although most boundaries carried over. The Czech term is kept in English: "district"
is ambiguous."""@en ;
    dcterms:source <https://apl2.czso.cz/iSMS/cisdet.jsp?kodcis=101> ;
    krim:businessDefinition "Okres podle zákona o územně správním členění státu (51/2020 Sb.) a číselníku 101 Českého statistického úřadu; skládá se z celých obcí a leží v jednom kraji."@cs ;
    skos:example "Opava (kód 40908, kód LAU 1 CZ0805)."@cs ;
    skos:scopeNote "Samosprávný celek ani správní obvod obce s rozšířenou působností; jejich hranice se téměř vždy shodují, ne však u Turnova."@cs ;
    vs:term_status "draft" .

krim:Kraj
    a owl:Class ;
    rdfs:subClassOf skos:Concept , gsp:Feature ;
    rdfs:label "kraj"@en , "kraj"@cs ;
    skos:altLabel "region (NUTS 3)"@en , "vyšší územní samosprávný celek"@cs ;
    skos:closeMatch <https://slovník.gov.cz/legislativní/sbírka/129/2000/pojem/kraj> ;
    skos:definition """A kraj is a self-governing territorial unit of the Czech Republic, the
highest level below the state, listed in the Czech Statistical Office's codelist 100,
identified by its four-digit code and corresponding to one EU NUTS 3 region."""@en ;
    skos:example "Moravskoslezský kraj (code 3140, NUTS CZ080)."@en ;
    skos:scopeNote """Not one of the eight kraje of 1960, which RÚIAN still keeps, and not a
NUTS 2 cohesion region (not modelled). Includes Prague (3018), which is governed by
its own act (131/2000), not by the Act on kraje (129/2000). The Czech term is kept in
English: "region" is ambiguous."""@en ;
    dcterms:source <https://apl2.czso.cz/iSMS/cisdet.jsp?kodcis=100> ;
    krim:businessDefinition "Kraj jako vyšší územní samosprávný celek podle číselníku 100 Českého statistického úřadu; odpovídá regionu NUTS 3."@cs ;
    skos:example "Moravskoslezský kraj (kód 3140, NUTS CZ080)."@cs ;
    skos:scopeNote "Kraj podle členění z roku 1960 (osm krajů) ani region soudržnosti (NUTS 2). Patří sem i hlavní město Praha (3018)."@cs ;
    vs:term_status "draft" .

# Modest axioms the reasoner can check: records and codelist concepts are
# different kinds of things, and the codelists do not overlap.
[] a owl:AllDisjointClasses ;
    owl:members ( krim:OffenceRecord krim:AnonymisationArea skos:Concept ) .

[] a owl:AllDisjointClasses ;
    owl:members ( krim:OffenceType krim:ClearanceState krim:LocationRelevance krim:Municipality
                  krim:OrpArea krim:Okres krim:Kraj ) .

# =====================================================================
# Object properties
# =====================================================================

krim:hasOffenceType
    a owl:ObjectProperty ;
    rdfs:label "has offence type"@en , "má typ deliktu"@cs ;
    skos:definition "A relation that assigns an offence type to an offence record."@en ;
    skos:scopeNote "A record usually has several types: the most specific ones and all their broader types."@en ;
    vs:term_status "draft" .

krim:hasClearanceState
    a owl:ObjectProperty ;
    rdfs:label "has clearance state"@en , "má stav objasnění"@cs ;
    skos:definition "A relation that assigns its current clearance state to an offence record."@en ;
    vs:term_status "draft" .

krim:hasLocationRelevance
    a owl:ObjectProperty ;
    rdfs:label "has location relevance"@en , "má relevanci lokality"@cs ;
    skos:definition "A relation that states what the recorded location of an offence record stands for."@en ;
    vs:term_status "draft" .

krim:inAnonymisationArea
    a owl:ObjectProperty ;
    rdfs:subPropertyOf dcterms:spatial ;
    rdfs:label "in anonymisation area"@en , "v anonymizační oblasti"@cs ;
    skos:definition "A relation that places an offence record in the anonymisation area whose centre is published as the record's location."@en ;
    skos:scopeNote "Derived by the loader: the published point is the centre of exactly one area. A point that is no area's centre is a data error and is reported, never placed in the nearest area."@en ;
    vs:term_status "draft" .

krim:inMunicipality
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gsp:sfWithin ;
    rdfs:label "in municipality"@en , "v obci"@cs ;
    skos:definition "A relation that places an anonymisation area in the municipality whose territory contains it."@en ;
    skos:scopeNote "Given by the publisher's list of areas (field kod_obec); every area lies in exactly one municipality."@en ;
    vs:term_status "draft" .

krim:inOrpArea
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gsp:sfWithin ;
    rdfs:label "in ORP area"@en , "ve správním obvodu ORP"@cs ;
    skos:definition "A relation that places a municipality in the ORP area whose territory contains it."@en ;
    skos:scopeNote "Given by ČSÚ's relation between codelists 43 and 65; every municipality lies in exactly one ORP area."@en ;
    vs:term_status "draft" .

krim:inOkres
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gsp:sfWithin ;
    rdfs:label "in okres"@en , "v okrese"@cs ;
    skos:definition "A relation that places a municipality in the okres whose territory contains it."@en ;
    skos:scopeNote """Given by ČSÚ's relation between codelists 43 and 101, the one link ČSÚ maintains
by hand. Not stated for ORP areas: that an ORP area lies within one okres is a soft rule
checked through its municipalities (Turnov is the known exception)."""@en ;
    vs:term_status "draft" .

krim:inKraj
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gsp:sfWithin ;
    rdfs:label "in kraj"@en , "v kraji"@cs ;
    skos:definition "A relation that places an ORP area or an okres in the kraj whose territory contains it."@en ;
    skos:scopeNote """Not stated for municipalities: a municipality's kraj is reached through its ORP
area or its okres, and both branches give the same kraj."""@en ;
    vs:term_status "draft" .

# =====================================================================
# Datatype properties
# =====================================================================

krim:reportDateTime
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf dcterms:date ;
    rdfs:label "report date and time"@en , "datum a čas oznámení"@cs ;
    skos:altLabel "datum ohlášení"@cs ;
    skos:definition """A date-time property that gives the date and time, to the minute
and with time zone, at which the recorded act was entered into the Police CR register
as reported."""@en ;
    skos:example "2025-02-19T20:34:00+01:00"@en ;
    skos:scopeNote """Not the time of commission. The publisher's help (napoveda,
"Filtrování dle období") states that an act reported on one day but entered into the
register the next day appears under the next day. Times of exactly 00:00 may stand
for an unknown time of day."""@en ;
    dcterms:source <https://kriminalita.policie.gov.cz/napoveda/#/rozvrzeni> ;
    krim:businessDefinition "Datum a čas, kdy byl skutek oznámen a zapsán do evidence Policie ČR, s přesností na minuty."@cs ;
    skos:example "19. 2. 2025 ve 20:34."@cs ;
    skos:scopeNote "Okamžik spáchání skutku. Skutek oznámený pozdě večer a zapsaný až další den se počítá ke dni zápisu. Čas 00:00 může znamenat neznámý čas."@cs ;
    vs:term_status "draft" .

krim:anonymisedLatitude
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:lat ;
    rdfs:label "anonymised latitude"@en , "anonymizovaná zeměpisná šířka"@cs ;
    skos:definition """A coordinate property that gives the WGS-84 latitude of the
centre of the anonymisation polygon into which the recorded location falls."""@en ;
    skos:scopeNote """Not the true place of the act. Municipalities are split into
Voronoi polygons around K-means cluster centres, and every location is moved to its
polygon's centre; small municipalities form a single polygon. Realises the source
field "y"; note that the publisher's OpenAPI description mislabels x as latitude and y as
longitude."""@en ;
    krim:businessDefinition "Zeměpisná šířka (WGS-84) středu anonymizační oblasti, do které skutečné místo skutku spadá."@cs ;
    skos:example "50,081 (oblast v centru Prahy)."@cs ;
    skos:scopeNote "Skutečné místo skutku. Obce jsou rozděleny na oblasti (Voroného polygony) a každá poloha je posunuta do středu své oblasti; malé obce tvoří jedinou oblast."@cs ;
    owl:deprecated true ;
    dcterms:isReplacedBy krim:inAnonymisationArea , krim:centreLatitude ;
    skos:editorialNote "Deprecated in iteration 2: the published point belongs to the record's anonymisation area, not to the record. Use krim:inAnonymisationArea, then krim:centreLatitude of the area."@en ;
    vs:term_status "archaic" .

krim:anonymisedLongitude
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:long ;
    rdfs:label "anonymised longitude"@en , "anonymizovaná zeměpisná délka"@cs ;
    skos:definition """A coordinate property that gives the WGS-84 longitude of the
centre of the anonymisation polygon into which the recorded location falls."""@en ;
    skos:scopeNote "Not the true place of the act; see krim:anonymisedLatitude. Realises the source field \"x\"."@en ;
    krim:businessDefinition "Zeměpisná délka (WGS-84) středu anonymizační oblasti, do které skutečné místo skutku spadá."@cs ;
    skos:example "14,421 (oblast v centru Prahy)."@cs ;
    skos:scopeNote "Skutečné místo skutku; viz anonymizovaná zeměpisná šířka. Pozor: popis API vydavatele zeměpisnou délku a šířku zaměňuje."@cs ;
    owl:deprecated true ;
    dcterms:isReplacedBy krim:inAnonymisationArea , krim:centreLongitude ;
    skos:editorialNote "Deprecated in iteration 2: the published point belongs to the record's anonymisation area, not to the record. Use krim:inAnonymisationArea, then krim:centreLongitude of the area."@en ;
    vs:term_status "archaic" .

krim:recordedByMunicipalPolice
    a owl:DatatypeProperty ;
    rdfs:label "recorded by municipal police"@en , "evidováno městskou policií"@cs ;
    skos:definition "A boolean property that states whether an offence record originates from a municipal police force rather than the Police of the Czech Republic."@en ;
    skos:scopeNote """Realises the source field "mp" (městská policie). The publisher's
OpenAPI description (/api/v2/docs.json) splits statistics into "sp" (state police) and
"mp" (municipal police) and describes the codelist flag "mp" as "offence class shared
with the municipal police". The help pages state that municipal-police offences are
being integrated through a dedicated interface."""@en ;
    skos:editorialNote "Meaning corroborated by the OpenAPI description, not stated verbatim for this field; confirm with the publisher."@en ;
    dcterms:source <https://kriminalita.policie.gov.cz/api/v2/docs.json> ;
    krim:businessDefinition "Příznak, zda záznam pochází od obecní či městské policie, a nikoli od Policie ČR."@cs ;
    skos:example "Ano u přestupku, který řešila městská policie."@cs ;
    skos:scopeNote "Význam je odvozen z dokumentace API vydavatele (statistiky „sp“ a „mp“); u tohoto pole jej vydavatel výslovně nepopisuje, proto je třeba jej ověřit."@cs ;
    vs:term_status "draft" .

krim:stateAsOf
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:label "state as of"@en , "stav ke dni"@cs ;
    skos:definition """A date-time property that gives the moment as of which the
publisher reported the current state of an offence record (its clearance state, types
and location)."""@en ;
    skos:example "2026-11-19T00:27:18: the record was last seen in data the publisher generated at that time."@en ;
    skos:scopeNote """Observation time, not event time: it says when the state was
known, not when the act was reported (krim:reportDateTime). Records are investigated
continuously and republished, so a state can change; only the latest observed state is
kept, and a clearance rate is meaningful only together with this date. Taken from the
publisher's 'updated' timestamp of the download that last contained the record."""@en ;
    krim:businessDefinition "Okamžik, ke kterému vydavatel uvedl současný stav záznamu (stav objasnění, třídy a polohu)."@cs ;
    skos:example "19. 11. 2026 v 0:27: záznam byl naposledy obsažen v datech, která vydavatel vygeneroval v tu chvíli."@cs ;
    skos:scopeNote "Datum oznámení. Uchovává se jen poslední známý stav, proto i míra objasněnosti platí jen k tomuto dni; nedávné skutky bývají ještě v šetření."@cs ;
    vs:term_status "draft" .

krim:centreLatitude
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:lat ;
    rdfs:label "centre latitude"@en , "zeměpisná šířka středu"@cs ;
    skos:definition """A coordinate property that gives the WGS-84 latitude of the centre
of an anonymisation area, the point published as the location of every offence record
in the area."""@en ;
    skos:example "50.0833 (area 29789 in Prague)."@en ;
    skos:scopeNote """Not the geometric centroid of the polygon: the publisher's defining
point (field def_bod_y), a K-means cluster centre, moved inside the municipality where
needed."""@en ;
    krim:businessDefinition "Zeměpisná šířka (WGS-84) středu anonymizační oblasti; právě tento bod se zveřejňuje jako místo všech skutků v oblasti."@cs ;
    skos:example "50,0833 (oblast 29789 v Praze)."@cs ;
    skos:scopeNote "Těžiště polygonu. Střed je středem shluku skutků, v případě potřeby posunutým dovnitř obce."@cs ;
    vs:term_status "draft" .

krim:centreLongitude
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:long ;
    rdfs:label "centre longitude"@en , "zeměpisná délka středu"@cs ;
    skos:definition """A coordinate property that gives the WGS-84 longitude of the centre
of an anonymisation area, the point published as the location of every offence record
in the area."""@en ;
    skos:example "14.6278 (area 29789 in Prague)."@en ;
    skos:scopeNote "Not the geometric centroid of the polygon; see krim:centreLatitude. The publisher's field def_bod_x."@en ;
    krim:businessDefinition "Zeměpisná délka (WGS-84) středu anonymizační oblasti; právě tento bod se zveřejňuje jako místo všech skutků v oblasti."@cs ;
    skos:example "14,6278 (oblast 29789 v Praze)."@cs ;
    skos:scopeNote "Těžiště polygonu; viz zeměpisná šířka středu."@cs ;
    vs:term_status "draft" .

# Reused datatype properties, declared for OWL DL tooling.
dcterms:identifier a owl:DatatypeProperty .
prov:generatedAtTime a owl:DatatypeProperty .
dcterms:modified   a owl:DatatypeProperty .
dcterms:date       a owl:DatatypeProperty .
geo:lat            a owl:DatatypeProperty .
geo:long           a owl:DatatypeProperty .
dcterms:isPartOf   a owl:ObjectProperty .
skos:broader       a owl:ObjectProperty .
skos:inScheme      a owl:ObjectProperty .
skos:exactMatch    a owl:ObjectProperty .
skos:topConceptOf  a owl:ObjectProperty .
dcterms:spatial    a owl:ObjectProperty .
gsp:sfWithin       a owl:ObjectProperty .
gsp:Feature        a owl:Class .
skos:Concept       a owl:Class .
skos:ConceptScheme a owl:Class .
prov:Entity        a owl:Class .
