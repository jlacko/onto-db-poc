# CQ06 Per calendar month of report: misdemeanour only / other only / both (not exclusive).
SELECT ?month (SUM(IF(?mis && !?oth, 1, 0)) AS ?misdemeanours)
              (SUM(IF(!?mis && ?oth, 1, 0)) AS ?other)
              (SUM(IF(?mis && ?oth, 1, 0)) AS ?both) WHERE {
  ?r a krim:OffenceRecord ; krim:reportDateTime ?dt .
  BIND(SUBSTR(STR(?dt), 1, 7) AS ?month)
  BIND(EXISTS { ?r krim:hasOffenceType/skos:broader* ktype:97 } AS ?mis)
  BIND(EXISTS { ?r krim:hasOffenceType/skos:broader* ?cat .
                ?cat skos:topConceptOf krimc:type . FILTER(?cat != ktype:97) } AS ?oth)
} GROUP BY ?month
