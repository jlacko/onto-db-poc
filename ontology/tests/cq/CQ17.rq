# CQ17 Records per municipality, every municipality of codelist 43 (0 where none).
SELECT ?municipality (COUNT(?r) AS ?records) WHERE {
  ?m a krim:Municipality ; skos:notation ?municipality .
  OPTIONAL { ?a krim:inMunicipality ?m . ?r a krim:OffenceRecord ; krim:inAnonymisationArea ?a }
} GROUP BY ?municipality
