# CQ07 Records inside 50.0-50.2 N, 14.2-14.7 E (the centre of the record's area).
SELECT ?record WHERE {
  ?r dcterms:identifier ?record ; krim:inAnonymisationArea ?a .
  ?a krim:centreLatitude ?lat ; krim:centreLongitude ?lon .
  FILTER(?lat >= 50.0 && ?lat <= 50.2 && ?lon >= 14.2 && ?lon <= 14.7)
}
