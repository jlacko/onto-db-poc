    krim:recordedByMunicipalPolice false ;
    krim:hasLocationRelevance krimc:relevance\/4 ;
    krim:hasOffenceType krimc:type\/35 , krimc:type\/42 ;
    krim:stateAsOf "2026-11-19T00:27:18"^^xsd:dateTime .

