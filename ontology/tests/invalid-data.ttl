@prefix krim:    <https://example.org/kriminalita/ontology#> .
@prefix krimc:   <https://example.org/kriminalita/code/> .
@prefix rec:     <https://example.org/kriminalita/record/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix area:    <https://example.org/kriminalita/area/> .
@prefix mun:     <https://example.org/kriminalita/code/municipality/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# Negative tests: each individual breaks exactly one rule. validate.py checks
# that SHACL reports each one (the expected violation is in the comment as
# "expect: <property local name>").

rec:9007 a krim:OffenceRecord ;               # expect: identifier (duplicate of record 1001; also flags rec:1001)
    dcterms:identifier 1001 ;
    krim:reportDateTime "2025-01-05T22:15:00+01:00"^^xsd:dateTime ;
    krim:inAnonymisationArea area:30685 ;
    krim:recordedByMunicipalPolice false ;
    krim:hasClearanceState krimc:state\/1 ; krim:hasLocationRelevance krimc:relevance\/4 ;
    krim:hasOffenceType krimc:type\/18 , krimc:type\/19 ;
    krim:stateAsOf "2026-12-01T00:00:00"^^xsd:dateTime .

rec:9001 a krim:OffenceRecord ;               # expect: hasClearanceState (missing)
    dcterms:identifier 9001 ;
    krim:reportDateTime "2025-02-01T10:00:00+01:00"^^xsd:dateTime ;
    krim:inAnonymisationArea area:30685 ;
    krim:recordedByMunicipalPolice false ;
    krim:hasLocationRelevance krimc:relevance\/4 ;
    krim:hasOffenceType krimc:type\/35 , krimc:type\/42 ;
    krim:stateAsOf "2026-11-19T00:27:18"^^xsd:dateTime .

rec:9002 a krim:OffenceRecord ;               # expect: hasClearanceState (two values)
    dcterms:identifier 9002 ;
    krim:reportDateTime "2025-02-01T10:00:00+01:00"^^xsd:dateTime ;
    krim:inAnonymisationArea area:30685 ;
    krim:recordedByMunicipalPolice false ;
    krim:hasClearanceState krimc:state\/1 , krimc:state\/2 ;
    krim:hasLocationRelevance krimc:relevance\/4 ;
    krim:hasOffenceType krimc:type\/35 , krimc:type\/42 ;
    krim:stateAsOf "2026-11-19T00:27:18"^^xsd:dateTime .

rec:9003 a krim:OffenceRecord ;               # expect: hasOffenceType (unknown code 999)
    dcterms:identifier 9003 ;
    krim:reportDateTime "2025-02-01T10:00:00+01:00"^^xsd:dateTime ;
    krim:inAnonymisationArea area:30685 ;
    krim:recordedByMunicipalPolice false ;
    krim:hasClearanceState krimc:state\/1 ; krim:hasLocationRelevance krimc:relevance\/4 ;
    krim:hasOffenceType krimc:type\/999 ;
    krim:stateAsOf "2026-11-19T00:27:18"^^xsd:dateTime .

rec:9004 a krim:OffenceRecord ;               # expect: inAnonymisationArea (not an area: a clearance state)
    dcterms:identifier 9004 ;
    krim:reportDateTime "2025-02-01T10:00:00+01:00"^^xsd:dateTime ;
    krim:inAnonymisationArea krimc:state\/1 ;
    krim:recordedByMunicipalPolice false ;
    krim:hasClearanceState krimc:state\/1 ; krim:hasLocationRelevance krimc:relevance\/4 ;
    krim:hasOffenceType krimc:type\/35 , krimc:type\/42 ;
    krim:stateAsOf "2026-11-19T00:27:18"^^xsd:dateTime .

rec:9005 a krim:OffenceRecord ;               # expect: reportDateTime (wrong datatype)
    dcterms:identifier 9005 ;
    krim:reportDateTime "19. 2. 2025" ;
    krim:inAnonymisationArea area:30685 ;
    krim:recordedByMunicipalPolice false ;
    krim:hasClearanceState krimc:state\/1 ; krim:hasLocationRelevance krimc:relevance\/4 ;
    krim:hasOffenceType krimc:type\/35 , krimc:type\/42 ;
    krim:stateAsOf "2026-11-19T00:27:18"^^xsd:dateTime .

rec:9006 a krim:OffenceRecord ;               # expect: suspectName (closed shape: undeclared property)
    dcterms:identifier 9006 ;
    krim:reportDateTime "2025-02-01T10:00:00+01:00"^^xsd:dateTime ;
    krim:inAnonymisationArea area:30685 ;
    krim:recordedByMunicipalPolice false ;
    krim:hasClearanceState krimc:state\/1 ; krim:hasLocationRelevance krimc:relevance\/4 ;
    krim:hasOffenceType krimc:type\/35 , krimc:type\/42 ;
    krim:stateAsOf "2026-11-19T00:27:18"^^xsd:dateTime ;
    krim:suspectName "Jan Novák" .

area:99901 a krim:AnonymisationArea ;          # expect: centreLatitude (out of range)
    dcterms:identifier 99901 ;
    krim:centreLatitude 95.0 ; krim:centreLongitude 14.4 ;
    krim:inMunicipality krimc:municipality\/554782 .

area:99902 a krim:AnonymisationArea ;          # expect: centreLatitude (same centre as area 30685; also flags area:30685)
    dcterms:identifier 99902 ;
    krim:centreLatitude 50.081089 ; krim:centreLongitude 14.420267 ;
    krim:inMunicipality krimc:municipality\/554782 .

area:99903 a krim:AnonymisationArea ;          # expect: inMunicipality (missing)
    dcterms:identifier 99903 ;
    krim:centreLatitude 50.2 ; krim:centreLongitude 14.6 .

mun:999901 a krim:Municipality , skos:Concept ;  # expect: inOkres (ORP area Opava is in Moravskoslezský kraj, okres Praha in Praha)
    skos:notation 999901 ;
    skos:prefLabel "Neexistující obec"@cs ;
    krim:inOrpArea krimc:orp-area\/8117 ;
    krim:inOkres krimc:okres\/40924 .
